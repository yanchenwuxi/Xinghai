<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/control_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <!-- 顶部：返回 / 片名 / 时间 / 网速 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dip"
        android:paddingTop="8dip"
        android:paddingRight="12dip">

        <ImageView
            android:id="@+id/ctl_back"
            android:layout_width="40dip"
            android:layout_height="40dip"
            android:padding="9dip"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/ctl_name"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ctl_net"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ctl_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dip"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 左侧：锁屏 / 弹幕开关 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|center_vertical"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="14dip">

        <ImageView
            android:id="@+id/ctl_lock"
            android:layout_width="34dip"
            android:layout_height="34dip"
            android:background="@drawable/bg_circle_black60"
            android:padding="7dip"
            android:src="@drawable/ic_unlock" />

        <ImageView
            android:id="@+id/ctl_danmaku"
            android:layout_width="34dip"
            android:layout_height="34dip"
            android:layout_marginTop="16dip"
            android:background="@drawable/bg_circle_black60"
            android:padding="7dip"
            android:src="@drawable/ic_danmaku" />
    </LinearLayout>

    <!-- 右侧：浮动 / 投屏 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|center_vertical"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingRight="14dip">

        <ImageView
            android:id="@+id/ctl_float"
            android:layout_width="34dip"
            android:layout_height="34dip"
            android:background="@drawable/bg_circle_black60"
            android:padding="7dip"
            android:src="@drawable/ic_float" />

        <ImageView
            android:id="@+id/ctl_more"
            android:layout_width="34dip"
            android:layout_height="34dip"
            android:layout_marginTop="16dip"
            android:background="@drawable/bg_circle_black60"
            android:padding="7dip"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- 中间：上一集 / 播放 / 下一集 + 状态 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ctl_prev"
                android:layout_width="40dip"
                android:layout_height="40dip"
                android:background="@drawable/bg_circle_black60"
                android:padding="7dip"
                android:src="@drawable/ic_prev" />

            <ImageView
                android:id="@+id/ctl_play"
                android:layout_width="48dip"
                android:layout_height="48dip"
                android:layout_marginLeft="24dip"
                android:layout_marginRight="24dip"
                android:background="@drawable/bg_circle_black60"
                android:padding="12dip"
                android:src="@drawable/ic_pause" />

            <ImageView
                android:id="@+id/ctl_next"
                android:layout_width="40dip"
                android:layout_height="40dip"
                android:background="@drawable/bg_circle_black60"
                android:padding="7dip"
                android:src="@drawable/ic_next" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/ctl_spin"
            android:layout_width="34dip"
            android:layout_height="34dip"
            android:layout_marginTop="14dip"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ctl_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dip"
            android:text="正在加载中~"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ctl_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dip"
            android:background="@drawable/bg_hint_pill"
            android:paddingLeft="14dip"
            android:paddingRight="14dip"
            android:paddingTop="4dip"
            android:paddingBottom="4dip"
            android:textColor="@color/orange"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 手势提示（亮度 / 音量 / 进度） -->
    <TextView
        android:id="@+id/ctl_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="70dip"
        android:background="@drawable/bg_hint_pill"
        android:paddingLeft="18dip"
        android:paddingRight="18dip"
        android:paddingTop="8dip"
        android:paddingBottom="8dip"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 底部：进度条 + 功能按钮条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingLeft="12dip"
        android:paddingRight="12dip"
        android:paddingBottom="6dip">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ctl_play2"
                android:layout_width="32dip"
                android:layout_height="32dip"
                android:padding="4dip"
                android:src="@drawable/ic_pause" />

            <TextView
                android:id="@+id/ctl_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dip"
                android:layout_marginRight="6dip"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/ctl_seek"
                android:layout_width="0dip"
                android:layout_height="20dip"
                android:layout_weight="1"
                android:max="1000"
                android:progressDrawable="@drawable/seek_progress"
                android:thumb="@drawable/seek_thumb" />

            <TextView
                android:id="@+id/ctl_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dip"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/ctl_expand"
                android:layout_width="32dip"
                android:layout_height="32dip"
                android:padding="5dip"
                android:src="@drawable/ic_expand" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/ctl_btns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
