<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg"
    android:orientation="vertical"
    android:paddingLeft="8dip"
    android:paddingTop="30dip"
    android:paddingRight="8dip">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dip"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/search_back"
            android:layout_width="34dip"
            android:layout_height="34dip"
            android:padding="7dip"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dip"
            android:layout_height="34dip"
            android:layout_marginLeft="2dip"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dip"
            android:paddingRight="10dip">

            <ImageView
                android:layout_width="15dip"
                android:layout_height="15dip"
                android:alpha="0.5"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dip"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dip"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="@color/white_44"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/search_clear"
                android:layout_width="16dip"
                android:layout_height="16dip"
                android:alpha="0.6"
                android:src="@drawable/ic_clear"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/search_go"
            android:layout_width="52dip"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="搜索"
            android:textColor="@color/orange"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/search_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dip"
                android:layout_marginTop="14dip"
                android:drawablePadding="4dip"
                android:text="@string/hot_search"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dip"
                android:layout_marginTop="10dip"
                android:layout_marginRight="8dip"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingLeft="10dip"
                android:paddingTop="12dip"
                android:paddingRight="10dip"
                android:paddingBottom="12dip">

                <LinearLayout
                    android:id="@+id/hot_row1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/hot_row2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dip"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dip"
                android:layout_marginLeft="8dip"
                android:layout_marginTop="12dip"
                android:layout_marginRight="8dip"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_history"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/history_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingLeft="10dip"
                    android:paddingRight="10dip"
                    android:text="@string/clear"
                    android:textColor="@color/white_44"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.zaka.xinghai.view.FlowLayout
                android:id="@+id/history_flow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dip"
                android:layout_marginTop="8dip"
                android:layout_marginRight="10dip" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <GridView
                android:id="@+id/result_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:horizontalSpacing="2dip"
                android:numColumns="3"
                android:paddingLeft="4dip"
                android:paddingRight="4dip"
                android:verticalSpacing="6dip"
                android:visibility="gone" />

            <TextView
                android:id="@+id/result_tip"
                android:layout_width="match_parent"
                android:layout_height="40dip"
                android:layout_gravity="top"
                android:gravity="center"
                android:textColor="@color/white_44"
                android:textSize="12sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/result_loading"
                android:layout_width="34dip"
                android:layout_height="34dip"
                android:layout_gravity="center"
                android:indeterminateTint="@color/orange"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
