<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg"
    android:orientation="vertical"
    android:paddingTop="30dip">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dip"
        android:paddingRight="12dip">

        <ImageView
            android:id="@+id/site_back"
            android:layout_width="40dip"
            android:layout_height="40dip"
            android:padding="9dip"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="接口管理"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/site_import"
            android:layout_width="wrap_content"
            android:layout_height="26dip"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingLeft="12dip"
            android:paddingRight="12dip"
            android:text="导入配置"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/site_add"
            android:layout_width="wrap_content"
            android:layout_height="26dip"
            android:layout_marginLeft="8dip"
            android:background="@drawable/bg_btn_accent"
            android:gravity="center"
            android:paddingLeft="12dip"
            android:paddingRight="12dip"
            android:text="添加"
            android:textColor="@color/main_bg"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/site_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dip"
        android:layout_marginRight="14dip"
        android:layout_marginBottom="6dip"
        android:textColor="@color/white_44"
        android:textSize="11sp" />

    <ListView
        android:id="@+id/site_list"
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1"
        android:divider="@null"
        android:paddingLeft="10dip"
        android:paddingRight="10dip"
        android:scrollbars="none" />
</LinearLayout>
