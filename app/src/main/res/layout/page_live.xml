<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg"
    android:orientation="vertical"
    android:paddingTop="30dip">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dip"
        android:paddingRight="14dip">

        <TextView
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="电视直播"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dip"
            android:textColor="@color/white_44"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/live_refresh"
            android:layout_width="20dip"
            android:layout_height="20dip"
            android:alpha="0.85"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ListView
            android:id="@+id/group_list"
            android:layout_width="92dip"
            android:layout_height="match_parent"
            android:background="@color/white_94"
            android:divider="@null"
            android:scrollbars="none" />

        <FrameLayout
            android:layout_width="0dip"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <GridView
                android:id="@+id/channel_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:horizontalSpacing="6dip"
                android:numColumns="3"
                android:paddingLeft="8dip"
                android:paddingRight="8dip"
                android:paddingTop="4dip"
                android:verticalSpacing="8dip" />

            <TextView
                android:id="@+id/live_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="6dip"
                android:text="还没有直播源\n点右上角刷新，或到「我的 → 直播源」粘贴 m3u 地址"
                android:textColor="@color/white_44"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
