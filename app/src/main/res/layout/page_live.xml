<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/live_player_box"
        android:layout_width="match_parent"
        android:layout_height="200dip"
        android:background="@color/black">

        <SurfaceView
            android:id="@+id/live_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/live_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#66000000"
            android:ellipsize="end"
            android:paddingLeft="12dip"
            android:paddingTop="8dip"
            android:paddingRight="12dip"
            android:paddingBottom="8dip"
            android:singleLine="true"
            android:text="选择下方频道开始播放"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/live_spin"
            android:layout_width="36dip"
            android:layout_height="36dip"
            android:layout_gravity="center"
            android:indeterminateTint="@color/orange"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dip"
        android:paddingRight="8dip">

        <TextView
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="电视直播"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dip"
            android:textColor="@color/white_44"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/live_refresh"
            android:layout_width="34dip"
            android:layout_height="34dip"
            android:padding="7dip"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ListView
            android:id="@+id/group_list"
            android:layout_width="96dip"
            android:layout_height="match_parent"
            android:background="#121212"
            android:divider="@null"
            android:scrollbars="none" />

        <FrameLayout
            android:layout_width="0dip"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <GridView
                android:id="@+id/channel_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:horizontalSpacing="8dip"
                android:numColumns="2"
                android:padding="8dip"
                android:stretchMode="columnWidth"
                android:verticalSpacing="8dip" />

            <TextView
                android:id="@+id/live_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="6dip"
                android:padding="20dip"
                android:text="还没有直播源"
                android:textColor="@color/white_44"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
