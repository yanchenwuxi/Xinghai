<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/detail_player_box"
        android:layout_width="match_parent"
        android:layout_height="200dip"
        android:background="@color/black">

        <SurfaceView
            android:id="@+id/detail_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/detail_play_icon"
            android:layout_width="48dip"
            android:layout_height="48dip"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_black60"
            android:padding="12dip"
            android:src="@drawable/ic_play"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/detail_spin"
            android:layout_width="36dip"
            android:layout_height="36dip"
            android:layout_gravity="center"
            android:indeterminateTint="@color/orange"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dip"
            android:layout_gravity="top"
            android:background="#66000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dip"
            android:paddingRight="8dip">

            <ImageView
                android:id="@+id/detail_back"
                android:layout_width="40dip"
                android:layout_height="40dip"
                android:padding="9dip"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/detail_title"
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/detail_expand"
            android:layout_width="44dip"
            android:layout_height="44dip"
            android:layout_gravity="right|bottom"
            android:layout_margin="10dip"
            android:background="@drawable/bg_circle_black60"
            android:padding="10dip"
            android:src="@drawable/ic_expand" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dip" />
        </ScrollView>

        <ProgressBar
            android:id="@+id/detail_loading"
            android:layout_width="36dip"
            android:layout_height="36dip"
            android:layout_gravity="center"
            android:indeterminateTint="@color/orange"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
