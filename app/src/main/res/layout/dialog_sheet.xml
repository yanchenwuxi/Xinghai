<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_bottom"
    android:orientation="vertical"
    android:paddingTop="8dip">

    <View
        android:layout_width="38dip"
        android:layout_height="4dip"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_flag_on" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dip"
        android:paddingRight="10dip">

        <TextView
            android:id="@+id/sheet_title"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/sheet_close"
            android:layout_width="34dip"
            android:layout_height="34dip"
            android:padding="8dip"
            android:src="@drawable/ic_close"
            android:alpha="0.8" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dip"
        android:background="@color/divider" />

    <ScrollView
        android:id="@+id/sheet_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/sheet_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dip"
            android:paddingTop="12dip"
            android:paddingRight="14dip"
            android:paddingBottom="18dip" />
    </ScrollView>
</LinearLayout>
