<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/video_area"
            android:layout_width="match_parent"
            android:layout_height="220dip"
            android:background="@color/black">

            <SurfaceView
                android:id="@+id/video"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.zaka.xinghai.view.SubtitleView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/gesture_hint"
                android:layout_width="60dip"
                android:layout_height="60dip"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_black60"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/video_play_icon"
                android:layout_width="46dip"
                android:layout_height="46dip"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_black60"
                android:padding="11dip"
                android:src="@drawable/ic_play"
                android:visibility="gone" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/play_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dip"
            android:layout_weight="1"
            android:background="@color/main_bg"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/play_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dip" />
        </ScrollView>
    </LinearLayout>

    <include
        android:id="@+id/control"
        layout="@layout/layout_player_control" />
</FrameLayout>
