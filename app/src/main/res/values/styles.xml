<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/main_bg</item>
        <item name="android:colorPrimaryDark">@color/main_bg</item>
        <item name="android:colorAccent">@color/orange</item>
        <item name="android:windowBackground">@color/main_bg</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white_44</item>
        <item name="android:statusBarColor">@color/main_bg</item>
        <item name="android:navigationBarColor">@color/main_bg</item>
    </style>

    <style name="AppTheme.Splash" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/main_bg</item>
    </style>

    <style name="AppTheme.Player" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="SheetDialog" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="TransparentDialog" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
